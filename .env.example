# NEXUS - configuración de desarrollo
# Copia este archivo a .env y rellena tus credenciales. NUNCA subas .env al repositorio.

# Proveedor Qwen (modo compatible OpenAI de DashScope / Alibaba Cloud Model Studio)
# Documentación: https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# Puerto del servicio HTTP local (loopback) usado por el frontend
NEXUS_PORT=47800

# Directorio de datos (opcional; por defecto ~/.local/share/nexus)
# NEXUS_DATA_DIR=

# Nivel de logs: error|warn|info|debug|trace
RUST_LOG=nexus=info,tower_http=warn
